{
  "schemaVersion": 1,
  "id": "wildshape",
  "version": "${version}",
  "name": "Towns & Kingdoms: Wildshape",
  "description": "A TerraForged-family terrain mod for Towns & Kingdoms with connected caverns and native biome compatibility.",
  "authors": [
    "Mikaaah (Wildshape)",
    "pandaismyname1 (upstream author)"
  ],
  "contributors": [
    "dags (TerraForged)",
    "Won-Ton (TerraForged)",
    "raccoonman (ReTerraForged)",
    "Steveplays28 (ReTerraForged)",
    "EdoEquin0x (ReTerraForged)",
    "Mikaaah (community fork)",
    "Mikaaah (Wildshape)"
  ],
  "contact": {
    "homepage": "https://github.com/Mikaaah/Towns-and-Kingdoms-Wildshape",
    "sources": "https://github.com/Mikaaah/Towns-and-Kingdoms-Wildshape",
    "issues": "https://github.com/Mikaaah/Towns-and-Kingdoms-Wildshape/issues"
  },
  "license": "MIT",
  "icon": "assets/wildshape/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "nl.townsandkingdoms.wildshape.fabric.WildshapeFabric"
    ]
  },
  "mixins": [
    "wildshape-common.mixins.json",
    "wildshape-fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": ">=${fabric_api_min}",
    "minecraft": "~${minecraft_version}",
    "java": ">=21"
  }
}
